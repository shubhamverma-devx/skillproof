# Provider chain, tried in this order. Every one of them is optional: without any
# key the deterministic planner, keyword resume parsing and the stored question
# bank run the whole product. See README "Graceful failure".

# Primary. Sarvam AI, India's own LLM platform. New accounts get free credits.
SARVAM_API_KEY=

# Fallback 1. Groq free tier, OpenAI compatible.
GROQ_API_KEY=

# Fallback 2. Google AI Studio free tier.
GEMINI_API_KEY=

# Optional. Promotes one provider to the front of the chain: sarvam, groq or gemini.
LLM_PRIMARY=sarvam

# Optional model overrides. Defaults are in lib/config.ts.
# SARVAM_MODEL=sarvam-105b
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash

# Optional. Raises the GitHub REST limit from 60 to 5000 requests an hour.
GITHUB_TOKEN=

# Optional. Without both values the app writes to a local JSON store in .data/
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# true records model replies for the demo profile into data/demo/llm_cache.json
DEMO_MODE=false
