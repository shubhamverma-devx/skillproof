# LLM provider (primary). Without it the app still runs: see DEMO_MODE and the
# deterministic fallbacks documented in README "Graceful failure".
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Optional secondary provider, used when the primary fails or is missing.
GEMINI_API_KEY=

# Optional. Raises the GitHub REST rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional. Without both values the app writes to a local JSON store in .data/
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# true forces the seeded demo profile and cached LLM responses for every request.
DEMO_MODE=false
